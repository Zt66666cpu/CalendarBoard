<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg_fill" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/border_linen" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="@color/stitch_wool" android:dashWidth="4dp" android:dashGap="3.5dp" />
        </shape>
    </item>
</layer-list>
