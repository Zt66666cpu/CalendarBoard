<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F4F6F1E7" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#DFD5C3" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#C8BAA2" android:dashWidth="4dp" android:dashGap="3.5dp" />
        </shape>
    </item>
</layer-list>
