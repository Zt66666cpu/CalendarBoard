<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="5dp">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="今天" android:textSize="19sp"
            android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/add" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="＋" android:textSize="23sp"
            android:textColor="#FFFFFF" android:contentDescription="添加事项" />
        <TextView android:id="@+id/refresh" android:layout_width="36dp" android:layout_height="36dp"
            android:gravity="center" android:text="↻" android:textSize="22sp"
            android:textColor="#DDEEFF" android:contentDescription="刷新" />
    </LinearLayout>
    <LinearLayout android:id="@+id/courseSection" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp"
        android:background="@drawable/widget_section_bg">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="课程" android:textSize="13sp" android:textStyle="bold" android:textColor="#BFD9F4" />
        <TextView android:id="@+id/course" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" 
            android:lineSpacingExtra="2dp" android:text="正在同步" android:textSize="14sp"
            android:textColor="#F7FAFF" />
    </LinearLayout>
    <LinearLayout android:id="@+id/todoSection" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="7dp"
        android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_section_bg">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="待办" android:textSize="13sp" android:textStyle="bold" android:textColor="#CEE9D6" />
        <TextView android:id="@+id/todo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" 
            android:lineSpacingExtra="2dp" android:text="正在同步" android:textSize="14sp"
            android:textColor="#F7FAFF" />
    </LinearLayout>
    <LinearLayout android:id="@+id/scheduleSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_section_bg">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日日程" android:textSize="13sp" android:textStyle="bold" android:textColor="#F4DDBF" />
        <TextView android:id="@+id/schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="5dp" android:textSize="14sp" android:textColor="#F7FAFF" />
    </LinearLayout>
    <TextView android:id="@+id/weekToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:padding="12dp" android:gravity="center_vertical" android:background="@drawable/widget_section_bg" android:text="明天起 7 天日程　›" android:textSize="14sp" android:textStyle="bold" android:textColor="#BFD9F4" />    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="7dp" android:ellipsize="end" android:singleLine="true"
        android:text="点＋添加 · 点卡片看完整日历" android:textSize="11sp" android:textColor="#C9D7E6" />
</LinearLayout>




