<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ink_primary" />

            <TextView
                android:id="@+id/weekBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_pill_bg"
                android:text=""
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/ink_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginRight="6dp"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:text="＋"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent_cocoa"
            android:contentDescription="添加事项" />

        <TextView
            android:id="@+id/refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:text="↻"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/accent_cocoa"
            android:contentDescription="刷新" />
    </LinearLayout>

    <!-- Course Card -->
    <LinearLayout
        android:id="@+id/courseSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/widget_section_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="●  课程"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/yarn_course" />

        <TextView
            android:id="@+id/course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="3dp"
            android:text="正在同步"
            android:textSize="13sp"
            android:textColor="@color/ink_primary" />
    </LinearLayout>

    <!-- Todo Card -->
    <LinearLayout
        android:id="@+id/todoSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/widget_section_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="●  待办"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/yarn_todo" />

        <ListView
            android:id="@+id/todoList"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="5dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:background="@color/transparent" />
    </LinearLayout>

    <!-- Schedule Card -->
    <LinearLayout
        android:id="@+id/scheduleSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/widget_section_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="●  今日日程"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/yarn_schedule" />

        <TextView
            android:id="@+id/schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="3dp"
            android:text="正在同步"
            android:textSize="13sp"
            android:textColor="@color/ink_primary" />
    </LinearLayout>

    <!-- 7-Day Agenda Pill -->
    <TextView
        android:id="@+id/weekToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="42dp"
        android:layout_marginTop="9dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:background="@drawable/widget_pill_bg"
        android:text="明天起 7 天  ›"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/accent_cocoa" />

    <!-- Sync Footer -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="7dp"
        android:paddingLeft="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="点 ＋ 添加 · 点卡片打开完整日历"
        android:textSize="11sp"
        android:textColor="@color/ink_muted" />
</LinearLayout>
